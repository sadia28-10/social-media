# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/social_platform
# Set to true for most managed databases (Render, Neon, Supabase, Railway)
DATABASE_SSL=false

# Separate, empty database used only by the automated tests (npm test). Its name must contain "test";
# every test run truncates all tables in it.
TEST_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/social_platform_test

# At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN_DAYS=7

# Origin(s) allowed to call the API with cookies (comma-separated)
CLIENT_ORIGIN=http://localhost:4000

# Cookie settings. In production use COOKIE_SECURE=true.
# Use COOKIE_SAMESITE=none only if the frontend and API are on different sites (requires COOKIE_SECURE=true).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Number of reverse proxies in front of the app (use 1 on Render/Heroku/Railway)
TRUST_PROXY=0

# Serve the ./client folder from Express (handy for local development)
SERVE_CLIENT=true
